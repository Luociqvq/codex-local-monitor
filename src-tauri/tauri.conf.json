      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCOTM5QTUzNjg2MjBGNzgKUldSNEQySm9VNXFUUzFYRHUrVE01YVFWeTdlWDNJMXpnYWJUNlJ1aXBsUXlnQjVmYnJoblNCQTEK",
      "endpoints": [
        "https://github.com/Luociqvq/codex-local-monitor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
